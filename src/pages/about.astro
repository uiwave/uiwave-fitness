---
import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/uiwave/Button";
import Heading from "@/components/uiwave/Heading.astro";
import { COACH } from "@/data/coach";
---

<Layout
    title="Sobre mí"
    description="Conoce a Alex Vega, entrenador personal certificado NSCA-CPT con más de 8 años de experiencia en entrenamiento de fuerza y composición corporal."
>
    <section class="section-padding">
        <div class="container-site">
            <div class="grid-12 items-center gap-10">
                <div class="col-span-4 md:col-span-5">
                    <div class="relative">
                        <div class="overflow-hidden">
                            <img
                                src={COACH.image}
                                alt={`Coach ${COACH.name}`}
                                loading="lazy"
                                decoding="async"
                                width="500"
                                height="625"
                                class="aspect-4/5 w-full object-cover"
                            />
                        </div>
                    </div>
                </div>
                <div class="col-span-4 md:col-span-7">
                    <Heading
                        title={`Entrenador ${COACH.name}`}
                        subtitle="Sobre mí"
                        level="h1"
                    />

                    <p
                        class="font-display text-primary mt-2 text-lg tracking-wide uppercase"
                    >
                        {COACH.role}
                    </p>
                    <p class="body-lg mt-6">
                        {COACH.bio}
                    </p>

                    <div class="mt-8">
                        <h3 class="headline-md">Certificaciones</h3>
                        <ul class="mt-4 space-y-2">
                            {
                                COACH.certifications.map((cert) => (
                                    <li class="flex items-center gap-2">
                                        <span
                                            class="text-primary"
                                            aria-hidden="true"
                                        >
                                            ✓
                                        </span>
                                        {cert}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <div class="mt-8">
                        <h3 class="headline-md">Filosofía</h3>
                        <p class="mt-4">
                            {COACH.philosophy}
                        </p>
                    </div>

                    <blockquote class="border-primary mt-8 border-l-2 pl-6">
                        <p class="italic">
                            "{COACH.quote}"
                        </p>
                    </blockquote>

                    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
                        <a href="/contact" class={buttonVariants({})}>
                            Agenda una llamada
                        </a>
                        <a
                            href="/programs"
                            class={buttonVariants({ variant: "secondary" })}
                        >
                            Ver programas
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
