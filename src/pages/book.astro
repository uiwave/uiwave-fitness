---
import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/uiwave/Button";
import Heading from "@/components/uiwave/Heading.astro";
---

<Layout
    title="Reservar consulta gratuita - UiWave Fitness"
    description="Reserva una consulta gratuita de 30 minutos para analizar tus objetivos y encontrar el programa ideal para ti."
>
    <section class="section-padding">
        <div class="container-site max-w-2xl">
            <Heading
                title="Reserva tu consulta gratuita"
                subtitle="Reservar"
                description="Cuéntanos sobre tus objetivos y te contactaremos para agendar una llamada de 30 minutos sin compromiso."
            />

            <form class="mt-10 space-y-6" id="contact-form">
                <div class="grid gap-6 sm:grid-cols-2">
                    <div>
                        <label for="name" class="label-sm mb-2 block">
                            Nombre completo
                        </label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            required
                            class="bg-card border-card focus:border-primary w-full border px-4 py-3 focus:outline-none"
                            placeholder="Tu nombre"
                        />
                    </div>
                    <div>
                        <label for="email" class="label-sm mb-2 block">
                            Correo electrónico
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            class="bg-card border-card focus:border-primary w-full border px-4 py-3 focus:outline-none"
                            placeholder="tu@email.com"
                        />
                    </div>
                </div>

                <div>
                    <label for="phone" class="label-sm mb-2 block">
                        Teléfono (opcional)
                    </label>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        class="bg-card border-card focus:border-primary w-full border px-4 py-3 focus:outline-none"
                        placeholder="+34 600 000 000"
                    />
                </div>

                <div>
                    <label for="goal" class="label-sm mb-2 block">
                        ¿Cuál es tu objetivo principal?
                    </label>
                    <select
                        id="goal"
                        name="goal"
                        required
                        class="bg-card border-card focus:border-primary w-full border px-4 py-3 focus:outline-none"
                    >
                        <option value="">Selecciona una opción</option>
                        <option value="strength">Ganar fuerza</option>
                        <option value="fat-loss">Pérdida de grasa</option>
                        <option value="performance">Mejorar rendimiento</option>
                        <option value="general">Fitness general</option>
                        <option value="other">Otro</option>
                    </select>
                </div>

                <div>
                    <label for="message" class="label-sm mb-2 block">
                        Cuéntanos más sobre ti
                    </label>
                    <textarea
                        id="message"
                        name="message"
                        rows="4"
                        class="bg-card border-card focus:border-primary w-full border px-4 py-3 focus:outline-none"
                        placeholder="Experiencia previa, disponibilidad horaria, cualquier cosa que consideres relevante..."
                    ></textarea>
                </div>

                <div>
                    <button
                        type="submit"
                        class={buttonVariants({ class: "w-full sm:w-auto" })}
                    >
                        Enviar solicitud
                    </button>
                    <p class="text-foreground/60 mt-3 text-sm">
                        Te contactaremos en menos de 24 horas para confirmar tu
                        cita.
                    </p>
                </div>
            </form>
        </div>
    </section>
</Layout>
