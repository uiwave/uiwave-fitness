---
import Layout from "@/layouts/Layout.astro";
import Heading from "@/components/uiwave/Heading.astro";
import { getCollection } from "astro:content";

const PROGRAMS = await getCollection("programs");
---

<Layout
    title="Programas - UiWave Fitness"
    description="Explora nuestros programas de entrenamiento personalizados para fuerza, pérdida de grasa, rendimiento y más."
>
    <section class="section-padding">
        <div class="container-site">
            <Heading
                title="Nuestros programas"
                subtitle="Programas"
                description="Programas de entrenamiento diseñados por expertos para diferentes objetivos y niveles de experiencia."
            />
            <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    PROGRAMS.map((program) => {
                        const { data, id } = program;
                        const {
                            image,
                            alt,
                            level,
                            duration,
                            title,
                            description,
                            price,
                        } = data;
                        return (
                            <article class="bg-card overflow-hidden">
                                <a href={`/programs/${id}`} class="group block">
                                    <div class="relative aspect-4/3 overflow-hidden">
                                        <img
                                            src={image}
                                            alt={alt}
                                            loading="lazy"
                                            decoding="async"
                                            width="400"
                                            height="300"
                                            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                                        />
                                        <div class="absolute inset-0" />
                                    </div>
                                    <div class="p-5">
                                        <div class="flex flex-wrap gap-2">
                                            <span class="inline-flex items-center px-2 py-1 font-mono text-xs font-medium tracking-wider uppercase">
                                                Nivel: {level}
                                            </span>
                                            <span class="inline-flex items-center px-2 py-1 font-mono text-xs font-medium tracking-wider uppercase">
                                                Duración: {duration}
                                            </span>
                                        </div>
                                        <h3 class="headline-md group-hover:text-primary mt-4 transition-colors">
                                            {title}
                                        </h3>
                                        <p class="mt-2 line-clamp-2 text-sm">
                                            {description}
                                        </p>
                                        <p class="label-sm text-primary mt-4">
                                            {price}
                                        </p>
                                    </div>
                                </a>
                            </article>
                        );
                    })
                }
            </div>
        </div>
    </section>
</Layout>
