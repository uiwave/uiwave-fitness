---
import Layout from "@/layouts/Layout.astro";
import Heading from "@/components/uiwave/Heading.astro";
import { ARTICLES } from "@/data/articles";

const ARTICLES_LIST = Object.entries(ARTICLES).map(
    ([slug, { title, date, content }]) => ({
        title,
        date,
        excerpt: content.replace(/<[^>]*>/g, "").slice(0, 120) + "...",
        slug,
    }),
);
---

<Layout
    title="Blog"
    description="Artículos sobre entrenamiento, nutrición y rendimiento deportivo. Contenido basado en evidencia científica."
>
    <section class="section-padding">
        <div class="container-site">
            <Heading
                title="Blog"
                subtitle="Blog"
                description="Artículos sobre entrenamiento, nutrición y rendimiento. Contenido basado en evidencia, no en tendencias."
                level="h1"
            />

            <div class="mt-10 grid gap-6 sm:grid-cols-2">
                {
                    ARTICLES_LIST.map((article) => (
                        <article class="bg-card group overflow-hidden">
                            <a href={`/blog/${article.slug}`} class="block p-6">
                                <p class="label-sm text-foreground/60">
                                    {article.date}
                                </p>
                                <h3 class="headline-md group-hover:text-primary mt-2 transition-colors">
                                    {article.title}
                                </h3>
                                <p class="mt-3 text-sm">{article.excerpt}</p>
                                <p class="label-sm text-primary mt-4">
                                    Leer más →
                                </p>
                            </a>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
