---
import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/uiwave/Button";
import Heading from "@/components/uiwave/Heading.astro";
import { CONTACT } from "@/consts";
---

<Layout
    title="Contacto"
    description="¿Tienes preguntas? Contáctanos o reserva tu consulta gratuita. Te responderemos lo antes posible."
>
    <section class="section-padding">
        <div class="container-site">
            <Heading
                title="Contáctanos"
                subtitle="Contacto"
                description="¿Tienes alguna pregunta o necesitas más información? Escríbenos o reserva una consulta gratuita."
            />

            <div class="mt-10 grid gap-10 lg:grid-cols-2">
                <div class="space-y-4">
                    <div class="bg-card p-5">
                        <p class="label-sm text-primary mb-1">Email</p>
                        <a
                            href={`mailto:${CONTACT.email}`}
                            class="hover:text-primary text-sm transition-colors"
                        >
                            {CONTACT.email}
                        </a>
                    </div>
                    <div class="bg-card p-5">
                        <p class="label-sm text-primary mb-1">WhatsApp</p>
                        <a
                            href={CONTACT.whatsapp}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-primary text-sm transition-colors"
                        >
                            {CONTACT.phone}
                        </a>
                    </div>
                    <div class="bg-card p-5">
                        <p class="label-sm text-primary mb-1">
                            Horario de atención
                        </p>
                        <p class="text-sm">{CONTACT.hours}</p>
                        <p class="text-sm">{CONTACT.hoursSaturday}</p>
                    </div>
                    <div class="bg-card p-5">
                        <p class="label-sm text-primary mb-1">Ubicación</p>
                        <p class="text-sm">{CONTACT.address}</p>
                        <a
                            href={CONTACT.mapUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="label-sm text-primary mt-1 inline-block hover:underline"
                        >
                            Ver en Google Maps →
                        </a>
                    </div>
                </div>

                <div>
                    <form class="space-y-5" id="contact-form">
                        <div class="grid gap-5 sm:grid-cols-2">
                            <div>
                                <label for="name" class="label-sm mb-2 block">
                                    Nombre completo
                                </label>
                                <input
                                    type="text"
                                    id="name"
                                    name="name"
                                    required
                                    class="bg-card border-card focus:border-primary focus-visible:ring-secondary w-full border px-4 py-3 focus-visible:ring-2 focus-visible:outline-none"
                                    placeholder="Tu nombre"
                                />
                            </div>
                            <div>
                                <label for="email" class="label-sm mb-2 block">
                                    Correo electrónico
                                </label>
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    required
                                    class="bg-card border-card focus:border-primary focus-visible:ring-secondary w-full border px-4 py-3 focus-visible:ring-2 focus-visible:outline-none"
                                    placeholder="tu@email.com"
                                />
                            </div>
                        </div>

                        <div>
                            <label for="phone" class="label-sm mb-2 block">
                                Teléfono (opcional)
                            </label>
                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                class="bg-card border-card focus:border-primary focus-visible:ring-secondary w-full border px-4 py-3 focus-visible:ring-2 focus-visible:outline-none"
                                placeholder={CONTACT.phone}
                            />
                        </div>

                        <div>
                            <label for="goal" class="label-sm mb-2 block">
                                ¿Cuál es tu objetivo principal?
                            </label>
                            <select
                                id="goal"
                                name="goal"
                                required
                                class="bg-card border-card focus:border-primary focus-visible:ring-secondary w-full border px-4 py-3 focus-visible:ring-2 focus-visible:outline-none"
                            >
                                <option value="">Selecciona una opción</option>
                                <option value="strength">Ganar fuerza</option>
                                <option value="fat-loss"
                                    >Pérdida de grasa</option
                                >
                                <option value="performance"
                                    >Mejorar rendimiento</option
                                >
                                <option value="general">Fitness general</option>
                                <option value="other">Otro</option>
                            </select>
                        </div>

                        <div>
                            <label for="message" class="label-sm mb-2 block">
                                Cuéntanos más sobre ti
                            </label>
                            <textarea
                                id="message"
                                name="message"
                                rows="4"
                                class="bg-card border-card focus:border-primary focus-visible:ring-secondary w-full border px-4 py-3 focus-visible:ring-2 focus-visible:outline-none"
                                placeholder="Experiencia previa, disponibilidad horaria, cualquier cosa que consideres relevante..."
                            ></textarea>
                        </div>

                        <div>
                            <button
                                type="submit"
                                class={buttonVariants({ class: "w-full" })}
                            >
                                Enviar solicitud
                            </button>
                            <p class="text-foreground/60 mt-3 text-sm">
                                Te contactaremos en menos de 24 horas para
                                confirmar tu cita.
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-12 overflow-hidden">
                <iframe
                    src={CONTACT.mapEmbed}
                    width="100%"
                    height="400"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Ubicación del gimnasio en Google Maps"
                    class="w-full"></iframe>
            </div>
        </div>
    </section>
</Layout>
