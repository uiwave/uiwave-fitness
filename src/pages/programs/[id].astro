---
import { buttonVariants } from "@/components/uiwave/Button";
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const programs = await getCollection("programs");

    return programs.map((program) => ({
        params: {
            id: program.id,
        },
        props: {
            program,
        },
    }));
}

const { program } = Astro.props;

const { Content } = await render(program);
---

<Layout title={program.data.title} description={program.data.description}>
    <div class="container-site section-padding">
        <nav aria-label="Breadcrumb" class="mb-6">
            <ol class="label-sm flex flex-wrap items-center gap-2">
                <li class="flex items-center gap-2">
                    <a href="/" class="hover:text-secondary">Inicio</a>
                </li><li class="flex items-center gap-2">
                    <span>/</span>
                    <a href="/programs" class="hover:text-secondary"
                        >Programas</a
                    >
                </li><li class="flex items-center gap-2">
                    <span>/</span>
                    <span class="text-primary">{program.data.title}</span>
                </li>
            </ol>
        </nav>
        <div class="grid-12 gap-8">
            <div class="col-span-4 md:col-span-7">
                <div class="flex flex-wrap gap-2">
                    <span
                        class="text-primary inline-flex items-center px-2 py-1 font-mono text-xs font-medium tracking-wider uppercase"
                    >
                        Nivel: {program.data.level}
                    </span>
                    <span
                        class="text-primary inline-flex items-center px-2 py-1 font-mono text-xs font-medium tracking-wider uppercase"
                    >
                        Duración: {program.data.duration}
                    </span>
                    <span
                        class="text-primary inline-flex items-center px-2 py-1 font-mono text-xs font-medium tracking-wider uppercase"
                    >
                        Desde: {program.data.price}
                    </span>
                </div>
                <h1 class="display-xl text-primary mt-6">
                    {program.data.title}
                </h1>
                <p class="body-lg mt-4">
                    {program.data.description}
                </p>
                <div class="prose mt-10">
                    <Content />
                </div>
                <div class="mt-10">
                    <a href="/contact" class={buttonVariants({})}>
                        Reserva una consulta gratuita
                    </a>
                </div>
            </div>
            <div class="col-span-4 md:col-span-5">
                <div class="sticky top-24 overflow-hidden">
                    <img
                        src={program.data.image}
                        alt={program.data.alt}
                        loading="lazy"
                        decoding="async"
                        width="600"
                        height="450"
                        class="aspect-4/3 w-full object-cover"
                    />
                    <div class="p-6">
                        <p class="label-sm">¿Listo para empezar?</p>
                        <p class="mt-2">
                            Solicite una consulta gratuita para analizar si este
                            programa se ajusta a sus objetivos.
                        </p>
                        <a
                            href="/contact"
                            class={buttonVariants({
                                variant: "secondary",
                                class: "w-full mt-4",
                            })}
                        >
                            Comience
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>
