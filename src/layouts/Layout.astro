---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const {
    title = "UiWave Fitness - Entrenamiento personalizado en España",
    description = "Entrenamiento basado en datos para fuerza, pérdida de grasa y rendimiento. Programas personalizados, seguimiento semanal y resultados medibles.",
    image = "/images/og-default.jpg",
} = Astro.props;

const canonicalURL = Astro.url.href;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#1a1a1a" />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_ES" />
        <meta property="og:url" content={canonicalURL} />
        <meta
            property="og:image"
            content={new URL(image, Astro.url.origin).href}
        />

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content={new URL(image, Astro.url.origin).href}
        />

        <link rel="canonical" href={canonicalURL} />
        <title>{title}</title>
    </head>
    <body class="flex min-h-screen flex-col">
        <a
            href="#main-content"
            class="focus:bg-primary focus:text-primary-foreground sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2"
        >
            Saltar al contenido principal
        </a>
        <Header />
        <main id="main-content" class="flex-1">
            <slot />
        </main>
        <Footer />
    </body>
</html>
