---
import { Button, buttonVariants } from "@/components/uiwave/Button";
const navItems = [
    { label: "Inicio", href: "/" },
    { label: "Programas", href: "/programs" },
    { label: "Precios", href: "/pricing" },
    { label: "Resultados", href: "/results" },
    { label: "Sobre mí", href: "/about" },
    { label: "Blog", href: "/blog" },
    { label: "Reservar", href: "/book" },
];
---

<header class="bg-background/95 sticky top-0 z-50 backdrop-blur-sm">
    <div
        class="container-site flex h-16 items-center justify-between gap-4 md:h-20"
    >
        <a
            href="/"
            class="font-display text-xl font-extrabold tracking-tight uppercase md:text-2xl"
        >
            UiWaveFitnes
        </a>
        <nav
            class="hidden items-center gap-6 lg:flex"
            aria-label="Main navigation"
        >
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        class="label-sm hover:text-primary transition-colors"
                    >
                        {item.label}
                    </a>
                ))
            }
        </nav>
        <div class="hidden lg:block">
            <a href="/book" class={buttonVariants({ size: "sm" })}>
                Reserva una consulta gratuita
            </a>
        </div>
        <Button
            size="icon"
            aria-label="Open menu"
            aria-controls="mobile-menu"
            id="menu-toggle"
            className="lg:hidden"
        >
            <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M3 5h14M3 10h14M3 15h14"
                    stroke="currentColor"
                    stroke-width="1.5"></path>
            </svg>
        </Button>
    </div>
    <nav
        id="mobile-menu"
        class="hidden lg:hidden"
        aria-label="Mobile navigation"
    >
        <div class="container-site flex flex-col gap-1 py-4">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        class="font-display px-2 py-3 text-lg font-semibold tracking-tight uppercase"
                    >
                        {item.label}
                    </a>
                ))
            }
        </div>
    </nav>
</header>

<script>
    import { $ } from "@/lib/dom";

    const menu = $("#mobile-menu");
    const menuToggle = $("#menu-toggle");

    function toggleMenu() {
        if (!menu || !menuToggle) return;

        menu.classList.toggle("hidden");
    }

    menuToggle?.addEventListener("click", toggleMenu);
</script>
