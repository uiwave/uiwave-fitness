---
import Heading from "@/components/uiwave/Heading.astro";
const FAQS = [
    {
        question: "¿Cómo puedo reservar una consulta gratuita?",
        answer: "Visita nuestra página de Reservar para programar una consulta de 30 minutos por videollamada o en persona. Hablaremos sobre tus objetivos, tu historial de entrenamiento y te recomendaremos el mejor programa para ti. Sin compromiso de inscripción.",
    },
    {
        question: "¿Cuál es la política de cancelación?",
        answer: "Las membresías mensuales se pueden cancelar con 30 días de aviso. Los paquetes de sesiones no son reembolsables pero sí transferibles. Creemos en ganarnos tu confianza cada mes — sin contratos a largo plazo.",
    },
    {
        question: "¿Qué certificaciones tienes?",
        answer: "El entrenador Alex Vega está certificado por la NSCA-CPT con credenciales adicionales en nutrición deportiva y ejercicio correctivo. Toda la planificación sigue principios basados en la evidencia de la literatura científica del ejercicio.",
    },
    {
        question: "¿Qué equipamiento necesito?",
        answer: "Depende de tu programa. Los clientes presenciales entrenan en nuestras instalaciones completamente equipadas. Los clientes online reciben programas adaptados al equipamiento disponible — desde gimnasios comerciales completos hasta setups mínimos en casa.",
    },
];
---

<section class="section-padding">
    <div class="container-site max-w-3xl">
        <Heading title="Preguntas frecuentes" subtitle="FAQ" />
        <div class="mt-10 space-y-3">
            {
                FAQS.map((faq) => (
                    <details class="group">
                        <summary class="font-display cursor-pointer list-none p-5 text-lg font-semibold uppercase">
                            <span class="flex items-center justify-between gap-4">
                                {faq.question}{" "}
                                <span
                                    class="text-primary transition-transform group-open:rotate-45"
                                    aria-hidden="true"
                                >
                                    +
                                </span>
                            </span>
                        </summary>
                        <div class="px-5 pt-4 pb-5">{faq.answer}</div>
                    </details>
                ))
            }
        </div>
    </div>
</section>
