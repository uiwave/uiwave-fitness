---
import { buttonVariants } from "@/components/uiwave/Button";
import Heading from "@/components/uiwave/Heading.astro";
import { COACH } from "@/data/coach";
---

<section class="section-padding">
    <div class="container-site">
        <div class="grid-12 items-center gap-10">
            <div class="col-span-4 md:col-span-5">
                <div class="relative">
                    <div class="overflow-hidden">
                        <img
                            src={COACH.image}
                            alt={`Coach ${COACH.name}`}
                            loading="lazy"
                            decoding="async"
                            width="500"
                            height="625"
                            class="aspect-4/5 w-full object-cover"
                        />
                    </div>
                </div>
            </div>
            <div class="col-span-4 md:col-span-7">
                <Heading
                    title={`Entrenador ${COACH.name}`}
                    subtitle="Tu entrenador"
                />

                <p
                    class="font-display text-primary mt-2 text-lg tracking-wide uppercase"
                >
                    {COACH.role}
                </p>
                <p class="body-lg mt-6">
                    {COACH.bioThirdPerson}
                </p>
                <blockquote class="border-primary mt-8 border-l-2 pl-6">
                    <p class="italic">
                        "{COACH.quote}"
                    </p>
                </blockquote>
                <div class="mt-8 flex flex-col gap-4 sm:flex-row">
                    <a href="/about" class={buttonVariants({})}>
                        Conoce a tu entrenador
                    </a>
                    <a
                        href="/contact"
                        class={buttonVariants({ variant: "secondary" })}
                    >
                        Agenda una llamada
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
