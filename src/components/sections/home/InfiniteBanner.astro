---
const ITEMS = [
    "fuerza",
    "rendimiento",
    "responsabilidad",
    "basado en datos",
    "sobrecarga progresiva",
    "entrenamiento élite",
    "resultados medibles",
];
---

<section class="overflow-hidden py-4">
    <div class="marquee-inner flex">
        {
            [0, 1].map(() => (
                <div class="flex shrink-0 gap-8 pr-8">
                    {ITEMS.map((item) => (
                        <span class="font-display flex shrink-0 items-center gap-8 text-2xl font-extrabold tracking-wider uppercase md:text-3xl">
                            {item}
                            <span class="text-primary">◆</span>
                        </span>
                    ))}
                </div>
            ))
        }
    </div>
</section>

<style>
    .marquee-inner {
        animation: marqueeScroll 28s linear infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee-inner {
            animation: none;
        }
    }

    @keyframes marqueeScroll {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }
</style>
