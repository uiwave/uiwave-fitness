---
import CardPrice from "@/components/card/CardPrice.astro";
import Heading from "@/components/uiwave/Heading.astro";
import { PLANS } from "@/data/plans";
---

<section class="section-padding">
    <div class="container-site">
        <Heading
            title="Elige tu plan"
            subtitle="Inversión"
            description="Precios transparentes sin cargos ocultos. Todos los planes incluyen una consulta inicial gratuita."
        />

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
                PLANS.map((plan) => (
                    <CardPrice
                        name={plan.name}
                        price={plan.price}
                        description={plan.description}
                        features={plan.features}
                        button={plan.button}
                        featured={plan.featured}
                        badge={plan.badge}
                    />
                ))
            }
        </div>
    </div>
</section>
