---
import Heading from "@/components/uiwave/Heading.astro";
const STEPS = [
    {
        number: "01",
        title: "Consulta gratuita",
        description:
            "Evaluamos tus objetivos, experiencia de entrenamiento y estilo de vida en una llamada de 30 minutos.",
    },
    {
        number: "02",
        title: "Programa personalizado",
        description:
            "Recibe un plan adaptado a ti, con sobrecarga progresiva incorporada en cada etapa.",
    },
    {
        number: "03",
        title: "Entrena y registra",
        description:
            "Registra tus sesiones en nuestra aplicación. Envía videos de tus ejercicios cuando quieras para recibir feedback.",
    },
    {
        number: "04",
        title: "Evalúa y adapta",
        description:
            "Realizamos revisiones semanales para ajustar las cargas, el volumen y la nutrición según tu progreso.",
    },
];
---

<section class="section-padding">
    <div class="container-site">
        <Heading
            title="Cómo funciona"
            subtitle="El proceso"
            description="Un sistema probado de cuatro pasos que convierte la ambición en resultados medibles."
        />
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            {
                STEPS.map((step) => (
                    <article class="bg-card group hover:border-primary relative border border-transparent p-6 transition-colors">
                        <p class="text-primary/30 group-hover:text-primary font-mono text-4xl font-medium transition-colors">
                            {step.number}
                        </p>
                        <h3 class="headline-md mt-4">{step.title}</h3>
                        <p class="mt-3 text-sm leading-relaxed">
                            {step.description}
                        </p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
