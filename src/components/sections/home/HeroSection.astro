---
import { buttonVariants } from "@/components/uiwave/Button";
---

<section
    class="relative isolate flex min-h-[84vh] items-center justify-center overflow-hidden"
>
    <div
        class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
        aria-hidden="true"
    >
        <video
            id="hero-video"
            class="h-full w-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/images/coach-alex.DTCMkw9A_Gqc4a.webp"
        >
            <source src="/videos/hero.mp4" type="video/mp4" />
        </video>

        <!-- Overlay oscuro -->
        <div class="absolute inset-0 bg-black/70"></div>
    </div>
    <div class="container-site section-padding relative z-10">
        <div class="grid-12 items-center">
            <div class="col-span-4 md:col-span-7">
                <p class="label-sm text-primary">
                    Personal Training · Austin, TX
                </p>

                <h1 class="display-xl mt-4">
                    Entrena más duro.<br />
                    <span class="text-primary"
                        >Seguimiento más inteligente.</span
                    >
                </h1>

                <p class="body-lg mt-6 max-w-xl">
                    Entrenamiento basado en datos para fuerza, pérdida de grasa
                    y rendimiento. Obtén un programa personalizado, seguimiento
                    semanal y resultados medibles.
                </p>

                <div
                    class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center"
                >
                    <a href="/book" class={buttonVariants({ size: "lg" })}
                        >Reserva una consulta gratuita</a
                    >
                    <a
                        href="/programs"
                        class={buttonVariants({
                            variant: "secondary",
                            size: "lg",
                        })}>Ver programas</a
                    >
                </div>

                <p class="label-sm mt-8">
                    Con la confianza de más de 200 clientes
                </p>
            </div>
        </div>
    </div>
</section>
