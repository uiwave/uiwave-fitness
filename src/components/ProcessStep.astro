---
import { STEPS } from "@/consts";
import Heading from "./uiwave/Heading.astro";
---

<section class="section-padding border-b border-surface-high">
    <div class="container-site">
        <Heading
            title="Cómo funciona"
            subtitle="El proceso"
            description="Un sistema probado de cuatro pasos que convierte la ambición en resultados medibles."
        />
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            {
                STEPS.map((step) => (
                    <article class="group relative card-surface p-6 transition-colors hover:border-primary-container/50">
                        <p class="font-mono text-4xl font-medium text-primary-container/30 transition-colors group-hover:text-primary-container">
                            {step.number}
                        </p>
                        <h3 class="headline-md mt-4 text-primary">
                            {step.title}
                        </h3>
                        <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">
                            {step.description}
                        </p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
