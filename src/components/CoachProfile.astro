---
import Heading from "./uiwave/Heading.astro";
---

<section class="section-padding border-y border-surface-high">
        <div class="container-site">
            <div class="grid-12 items-center gap-10">
                <div class="col-span-4 md:col-span-5">
                    <div class="relative">
                        <div class="card-surface overflow-hidden">
                            <img
                                src="/_astro/coach-alex.DTCMkw9A_Gqc4a.webp"
                                alt="Coach Alex Vega"
                                loading="lazy"
                                decoding="async"
                                width="500"
                                height="625"
                                class="aspect-4/5 w-full object-cover"
                            />
                        </div>
                        <div
                            class="absolute -bottom-4 -right-4 border border-primary-container bg-surface-container px-4 py-3"
                            style="box-shadow: var(--shadow-glow-primary)"
                        >
                            <p
                                class="font-mono text-2xl font-medium text-primary-container"
                            >
                                8+
                            </p>
                            <p class="label-sm text-outline">Years</p>
                        </div>
                    </div>
                </div>
                <div class="col-span-4 md:col-span-7">
                    <Heading title="Coach Alex Vega" subtitle="Your coach" />

                    <p
                        class="mt-2 font-display text-lg uppercase tracking-wide text-primary-container"
                    >
                        Head Coach &amp; Founder
                    </p>
                    <p class="body-lg mt-6 text-on-surface-variant">
                        With 8 years of coaching experience and an NSCA-CPT
                        certification, Alex specializes in strength
                        periodization and body composition transformation.
                        Former collegiate athlete turned data-driven coach, Alex
                        believes every client deserves programming backed by
                        science, not trends.
                    </p>
                    <div class="mt-6 flex flex-wrap gap-2">
                        <span
                            class="inline-flex items-center bg-chip-bg px-2 py-1 font-mono text-xs font-medium uppercase tracking-wider text-primary"
                        >
                            NSCA-Certified Personal Trainer
                        </span><span
                            class="inline-flex items-center bg-chip-bg px-2 py-1 font-mono text-xs font-medium uppercase tracking-wider text-primary"
                        >
                            Precision Nutrition Level 1
                        </span><span
                            class="inline-flex items-center bg-chip-bg px-2 py-1 font-mono text-xs font-medium uppercase tracking-wider text-primary"
                        >
                            FMS Level 2
                        </span><span
                            class="inline-flex items-center bg-chip-bg px-2 py-1 font-mono text-xs font-medium uppercase tracking-wider text-primary"
                        >
                            CPR/AED Certified
                        </span>
                    </div>
                    <blockquote
                        class="mt-8 border-l-2 border-primary-container pl-6"
                    >
                        <p class="text-on-surface-variant italic">
                            “Every rep counts. Every session is an opportunity
                            to get 1% better. My job is to make sure you never
                            waste one.”
                        </p>
                    </blockquote>
                    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
                        <a
                            href="/about"
                            class="inline-flex items-center justify-center font-display font-bold uppercase tracking-wide transition-transform focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary-container bg-primary-container text-on-primary hover:scale-[1.02] active:scale-[0.98] px-6 py-3 text-base btn-clipped"
                        >
                            Meet Your Coach
                        </a>
                        <a
                            href="/book"
                            class="inline-flex items-center justify-center font-display font-bold uppercase tracking-wide transition-transform focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary-container border border-secondary-container bg-transparent text-secondary-container hover:bg-secondary-container/10 px-6 py-3 text-base rounded-sm"
                        >
                            Book a Call
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>