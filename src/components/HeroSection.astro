---
import Button from "./uiwave/Button.astro";
---

<section
    class="relative isolate min-h-[84vh] overflow-hidden border-b border-surface-high flex items-center justify-center"
>
    <div
        class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
        aria-hidden="true"
    >
        <video
            class="h-full w-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/images/hero-poster.webp"
        >
            <source src="/videos/hero.mp4" type="video/mp4" />
        </video>
    </div>
    <div
        class="pointer-events-none absolute inset-0 z-[-5] bg-linear-to-r from-background via-background/95 55% to-transparent"
        aria-hidden="true"
    >
    </div>
    <div
        class="pointer-events-none absolute inset-0 z-[-4] bg-linear-to-t from-background/50 via-transparent to-transparent"
        aria-hidden="true"
    >
    </div>
    <div
        class="pointer-events-none absolute inset-0 z-[-3] opacity-20"
        style="background-image: linear-gradient(rgba(195,244,0,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(195,244,0,0.05) 1px, transparent 1px); background-size: 48px 48px;"
        aria-hidden="true"
    >
    </div>
    <div class="container-site relative z-10 section-padding">
        <div class="grid-12 items-center">
            <div class="col-span-4 md:col-span-7">
                <p class="label-sm text-primary-container">
                    Personal Training · Austin, TX
                </p>

                <h1 class="display-xl mt-4 text-primary">
                    Entrena más duro.<br />
                    <span class="text-primary-container"
                        >Seguimiento más inteligente.</span
                    >
                </h1>

                <p class="body-lg mt-6 max-w-xl text-on-surface-variant">
                    Entrenamiento basado en datos para fuerza, pérdida de grasa
                    y rendimiento. Obtén un programa personalizado, seguimiento
                    semanal y resultados medibles.
                </p>

                <div
                    class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center"
                >
                    <Button size="lg" href="/book" label="Reserva una consulta gratuita"/>

                    <Button size="lg" variant="secondary" href="/programs" label="Ver programas"/>
                </div>

                <p class="mt-8 label-sm text-outline">
                    Con la confianza de más de 200 clientes
                </p>
            </div>
        </div>
    </div>
</section>
