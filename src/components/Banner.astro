---
import { buttonVariants } from "./uiwave/Button";
import Heading from "./uiwave/Heading.astro";
---

<section class="section-padding">
    <div class="container-site">
        <div
            class="card-surface card-featured relative overflow-hidden px-8 py-12 text-center md:px-16 md:py-16"
        >
            <div
                class="pointer-events-none absolute inset-0 opacity-30"
                style="background: radial-gradient(ellipse at center, rgba(195,244,0,0.15) 0%, transparent 70%);"
            >
            </div>
            <div class="relative">
                <Heading
                    class="max-w-full text-center"
                    title="¿Listo para comenzar tu transformación?"
                    subtitle="Siguiente paso"
                    description="Reserva una consulta gratuita de 30 minutos. Evaluaremos tus objetivos, hablaremos sobre tu historial de entrenamiento y diseñaremos un plan que se adapte a tu horario."
                />
                <div
                    class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row"
                >
                    <a href="/book" class={buttonVariants({})}>
                        Reserva una consulta gratuita
                    </a>
                    <a
                        href="/contact"
                        class={buttonVariants({ variant: "secondary" })}
                    >
                        Contacta con nosotros
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
