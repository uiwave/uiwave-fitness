---
import CardPrice from "./card/CardPrice.astro";
import Heading from "./uiwave/Heading.astro";

const PLANS = [
    {
        name: "Starter",
        price: 149,
        description:
            "Perfect for beginners who want structure and accountability.",
        features: [
            "Custom training plan",
            "2 sessions per month",
            "Form check videos",
            "App-based tracking",
        ],
        button: "Get Started",
        featured: false,
    },
    {
        name: "Performance",
        price: 299,
        description:
            "Our most popular plan for serious strength and body composition goals.",
        features: [
            "Everything in Starter",
            "4 sessions per month",
            "Nutrition guidance",
            "Weekly check-ins",
            "Priority scheduling",
        ],
        button: "Start Performance",
        featured: true,
        badge: "Most Popular",
    },
    {
        name: "Elite",
        price: 499,
        description: "Maximum support for athletes and high-performers.",
        features: [
            "Everything in Performance",
            "8 sessions per month",
            "Recovery protocols",
            "Competition prep",
            "Direct messaging access",
        ],
        button: "Go Elite",
        featured: false,
    },
];
---

<section class="section-padding">
    <div class="container-site">
        <Heading
            title="Choose Your Pla"
            subtitle="Investment"
            description="Transparent pricing with no hidden fees. All plans include a free initial consultation."
        />

        <div class="mt-10 grid gap-6 lg:grid-cols-3">
            {
                PLANS.map((plan) => (
                    <CardPrice
                        name={plan.name}
                        price={plan.price}
                        description={plan.description}
                        features={plan.features}
                        button={plan.button}
                        featured={plan.featured}
                        badge={plan.badge}
                    />
                ))
            }
        </div>
    </div>
</section>
