---
import Heading from "./uiwave/Heading.astro";
const FAQS = [
    {
        question: "How do I book a free consultation?",
        answer: "Visit our Book page to schedule a 30-minute video or in-person consultation. We'll discuss your goals, training history, and recommend the best program for you. No obligation to sign up.",
    },
    {
        question: "What is your cancellation policy?",
        answer: "Monthly memberships can be cancelled with 30 days notice. Session packages are non-refundable but can be transferred. We believe in earning your business every month — no long-term contracts required.",
    },
    {
        question: "What certifications do you hold?",
        answer: "Coach Alex Vega is NSCA-CPT certified with additional credentials in sports nutrition and corrective exercise. All programming follows evidence-based principles from exercise science literature.",
    },
    {
        question: "What equipment do I need?",
        answer: "It depends on your program. In-person clients train at our fully equipped facility. Online clients receive programs tailored to their available equipment — from full commercial gyms to minimal home setups.",
    },
];
---

<section class="section-padding">
    <div class="container-site max-w-3xl">
        <Heading title="Common Questions" subtitle="FAQ" />
        <div class="mt-10 space-y-3">
            {
                FAQS.map((faq) => (
                    <details class="card-surface group">
                        <summary class="font-display cursor-pointer list-none p-5 text-lg font-semibold uppercase marker:content-none [&::-webkit-details-marker]:hidden">
                            <span class="flex items-center justify-between gap-4">
                                {faq.question}{" "}
                                <span
                                    class="text-primary transition-transform group-open:rotate-45"
                                    aria-hidden="true"
                                >
                                    +
                                </span>
                            </span>
                        </summary>
                        <div class="px-5 pt-4 pb-5">{faq.answer}</div>
                    </details>
                ))
            }
        </div>
    </div>
</section>
