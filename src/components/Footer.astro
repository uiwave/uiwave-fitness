---
const year = new Date().getFullYear();

const footerLinks = [
    { label: "Programas", href: "/programs" },
    { label: "Precios", href: "/pricing" },
    { label: "Resultados", href: "/results" },
    { label: "Sobre mí", href: "/about" },
    { label: "Blog", href: "/blog" },
];

const legalLinks = [
    { label: "Política de privacidad", href: "/privacy" },
    { label: "Términos y condiciones", href: "/terms" },
];
---

<footer class="bg-card border-card mt-auto border-t">
    <div class="container-site section-padding">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            <div class="sm:col-span-2 lg:col-span-1">
                <a
                    href="/"
                    class="font-display text-xl font-extrabold tracking-tight uppercase md:text-2xl"
                >
                    UiWaveFitnes
                </a>
                <p class="mt-3 text-sm">
                    Entrenamiento basado en datos para fuerza, pérdida de grasa
                    y rendimiento.
                </p>
            </div>

            <div>
                <p class="label-sm text-primary mb-3">Navegación</p>
                <ul class="space-y-2">
                    {
                        footerLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="hover:text-primary text-sm transition-colors"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div>
                <p class="label-sm text-primary mb-3">Contacto</p>
                <ul class="space-y-2">
                    <li>
                        <a
                            href="mailto:hola@uiwavefitness.com"
                            class="hover:text-primary text-sm transition-colors"
                        >
                            hola@uiwavefitness.com
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://wa.me/34600000000"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-primary text-sm transition-colors"
                        >
                            +34 600 000 000
                        </a>
                    </li>
                </ul>
            </div>

            <div>
                <p class="label-sm text-primary mb-3">Legal</p>
                <ul class="space-y-2">
                    {
                        legalLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="hover:text-primary text-sm transition-colors"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <div class="border-card mt-8 border-t pt-6 text-center text-sm">
            <p>&copy; {year} UiWave Fitness. Todos los derechos reservados.</p>
        </div>
    </div>
</footer>
