---
import { cn } from "@/lib/utils";
import { buttonVariants } from "@/components/uiwave/Button";
interface Props {
    title: string;
    subtitle: string;
    description?: string;
    level?: "h1" | "h2";
    link?: {
        href: string;
        label: string;
    };
    class?: string;
}

const {
    title,
    subtitle,
    description,
    level = "h2",
    link,
    class: className,
} = Astro.props;
---

<div class={cn("max-w-2xl", className)}>
    <p class="label-sm text-secondary">{subtitle}</p>
    {
        level === "h1" ? (
            <h1 class="display-xl text-primary mt-2">{title}</h1>
        ) : (
            <h2 class="headline-lg text-primary mt-2">{title}</h2>
        )
    }
    {description && <p class="mt-4">{description}</p>}
</div>
{
    link && (
        <a href={link.href} class={buttonVariants({ variant: "link" })}>
            {link.label} →
        </a>
    )
}
