---
import { cn } from "@/lib/utils";
interface Props {
    title: string;
    subtitle: string;
    description?: string;
    link?: {
        href: string;
        label: string;
    };
    class?: string;
}

const { title, subtitle, description, link, class: className } = Astro.props;
---

<div class={cn("max-w-2xl", className)}>
    <p class="label-sm text-secondary-container">{subtitle}</p>
    <h2 class="headline-lg mt-2 text-primary">{title}</h2>
    {description && <p class="mt-4 text-on-surface-variant">{description}</p>}
</div>
{
    link && (
        <a
            href={link.href}
            class="inline-flex items-center justify-center font-display font-bold uppercase tracking-wide transition-transform focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary-container bg-transparent text-primary hover:text-secondary-container px-4 py-2 text-sm rounded-sm"
        >
            {link.label} →
        </a>
    )
}
