---
interface Props {
    name: string;
    price: string;
    description: string;
    features: string[];
    button: string;
    featured: boolean;
    badge?: string;
}

const { name, price, description, features, button, featured, badge } =
    Astro.props;
---

<article
    class:list={["card-surface flex flex-col p-6", featured && "card-featured"]}
>
    {
        badge && (
            <span class="inline-flex items-center bg-chip-bg px-2 py-1 font-mono text-xs font-medium uppercase tracking-wider text-primary mb-4 self-start">
                {badge}
            </span>
        )
    }
    <h3 class="headline-md text-primary">{name}</h3>
    <p class="mt-4">
        <span
            class="font-display text-4xl font-extrabold text-primary-container"
        >
            ${price}
        </span>
        <span class="text-on-surface-variant">/month</span>
    </p>
    <p class="mt-4 text-sm text-on-surface-variant">
        {description}
    </p>
    <ul class="mt-6 flex-1 space-y-3">
        {
            features.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-on-surface-variant">
                    <span class="text-primary-container" aria-hidden="true">
                        ✓
                    </span>{" "}
                    {feature}
                </li>
            ))
        }
    </ul>
    <a
        href="/book"
        class="inline-flex items-center font-display font-bold uppercase tracking-wide transition-transform focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary-container border border-secondary-container bg-transparent text-secondary-container hover:bg-secondary-container/10 px-6 py-3 text-base rounded-sm mt-8 w-full justify-center"
    >
        Get Started
    </a>
</article>
