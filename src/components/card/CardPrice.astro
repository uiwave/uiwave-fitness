---
import { buttonVariants } from "@/components/uiwave/Button";

interface Props {
    name: string;
    price: number;
    description: string;
    features: string[];
    button: string;
    featured: boolean;
    badge?: string;
}

const { name, price, description, features, button, featured, badge } =
    Astro.props;
---

<article
    class:list={[
        "bg-card flex flex-col p-6",
        featured && "border-primary border",
    ]}
>
    {
        badge && (
            <span class="mb-4 inline-flex items-center self-start px-2 py-1 font-mono text-xs font-medium tracking-wider uppercase">
                {badge}
            </span>
        )
    }
    <h3 class="headline-md">{name}</h3>
    <p class="mt-4">
        <span class="font-display text-primary text-4xl font-extrabold">
            ${price}
        </span>
        <span class="">/mes</span>
    </p>
    <p class="mt-4 text-sm">
        {description}
    </p>
    <ul class="mt-6 flex-1 space-y-3">
        {
            features.map((feature) => (
                <li class="flex items-start gap-2 text-sm">
                    <span class="text-primary" aria-hidden="true">
                        ✓
                    </span>{" "}
                    {feature}
                </li>
            ))
        }
    </ul>
    <a href="/contact" class={buttonVariants({ class: "mt-8" })}> {button} </a>
</article>
